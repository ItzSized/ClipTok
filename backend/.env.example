# --- IA GRATUITES (au moins une) -------------------------------------------
# Utilisées pour la curation des clips et l'Éditeur IA. Plusieurs clés = relais
# automatique si l'une atteint son quota ou tombe en panne.
#   Gemini     : https://aistudio.google.com/apikey   (plusieurs clés : séparées par des virgules)
#   Groq       : https://console.groq.com/keys         (très rapide)
#   OpenRouter : https://openrouter.ai/keys            (modèles « :free »)
#   Mistral    : https://console.mistral.ai            (offre « Experiment » gratuite)
#   Cerebras   : https://cloud.cerebras.ai
#   Ollama     : https://ollama.com (local, hors ligne) puis `ollama pull qwen2.5:7b`
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=
# CEREBRAS_API_KEY=
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_BASE_URL=http://localhost:11434/v1
# Ordre d'essai des fournisseurs (par défaut : gemini,groq,openrouter,mistral,cerebras,ollama)
# AI_PROVIDERS=groq,gemini
# Modèles (surchargeables, les catalogues gratuits évoluent) : <FOURNISSEUR>_MODEL et <FOURNISSEUR>_MODEL_FAST
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# GEMINI_MODEL_SMART=gemini-flash-latest
PORT=4000

# Chemins des exécutables externes (laisser tel quel si dans le PATH système)
YTDLP_PATH=yt-dlp
PYTHON_PATH=python

# Optionnel : nécessaire si YouTube bloque yt-dlp avec une vérification anti-bot
# ("Sign in to confirm you're not a bot"). Un fallback client "android" est déjà
# tenté automatiquement, mais des cookies restent parfois indispensables.
# YTDLP_COOKIES=C:\chemin\vers\cookies.txt
# YTDLP_COOKIES_FROM_BROWSER=chrome
# YTDLP_EXTRA_ARGS=--extractor-args youtube:player_client=android

# Origine autorisée pour le CORS du frontend (laisser vide = toutes origines, pratique en dev)
# FRONTEND_URL=http://localhost:3000

# Modèle Gemini de repli si le modèle choisi n'existe pas (404)
CURATOR_MODEL=gemini-flash-latest

# Nombre de jobs de génération exécutés en parallèle (le pipeline est lourd en CPU/mémoire)
# MAX_CONCURRENT_JOBS=1

# Modèle faster-whisper utilisé en mode "précis" (le mode "rapide" force toujours "tiny")
# WHISPER_MODEL=base

# Dossier racine pour stocker les fichiers volumineux (médias importés, cache, clips rendus, temp)
# Par défaut : D:\Whop\ClipTok si D:\Whop existe
# STORAGE_DIR=D:\Whop\ClipTok
